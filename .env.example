NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side tooling only. Never expose this with a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY is accepted as a legacy fallback for the same value.
SUPABASE_SECRET_KEY=your-secret-key

# Transactional email. RESEND_FROM must be on a domain verified in Resend;
# leave it unset locally to use Resend's shared sandbox sender. Without
# RESEND_API_KEY, password resets and league/draft invitations cannot send.
RESEND_API_KEY=
RESEND_FROM="DraftHQ <noreply@drafthq.net>"

# Cloudflare Turnstile site key, for bot protection on auth endpoints.
# Create at Cloudflare dashboard > Turnstile. Leave unset to disable locally.
#
# This is HALF of a two-sided switch. The other half is Supabase Dashboard >
# Authentication > Attack Protection > enable CAPTCHA (provider: Turnstile,
# with the matching SECRET key). Enable the Supabase side WITHOUT this key set
# and every auth endpoint starts rejecting requests, including anonymous
# sign-in for guest draft joins.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Walk-up music ────────────────────────────────────────────────────────────

# Spotify app credentials, from developer.spotify.com > your app.
#
# These do double duty. Spotify SEARCH runs on the client-credentials flow,
# so /api/music/spotify-search works for every user with no one logging in.
# The same pair also drives the OAuth link that a user needs for full-track
# playback through the Web Playback SDK (Premium accounts only).
#
# Register <NEXT_PUBLIC_SITE_URL>/spotify-callback as a redirect URI in the
# Spotify dashboard — it must match byte for byte, so a www/apex mismatch
# between the two breaks the flow. While the Spotify app is in Development
# mode, only accounts added under User Management (max 25) can link.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key, from console.cloud.google.com (enable the API under
# APIs & Services > Library, then create an API key and restrict it to that API).
#
# Used to find a YouTube match when someone picks a Spotify track, which is the
# fallback that lets the song play on devices without a linked Premium account.
# Spotify no longer returns preview clips for newer apps, so this is the ONLY
# fallback. Without it every Spotify pick is stored with no fallback and plays
# only on the linked device.
#
# Note the quota: 10,000 units/day free, and a search costs 100 units — roughly
# 100 song additions per day. Pasting a YouTube link directly uses oEmbed and
# needs no key.
YOUTUBE_DATA_API_KEY=

# ── Optional integrations ────────────────────────────────────────────────────

# Yahoo Fantasy league import. Unset simply disables the Yahoo provider.
# YAHOO_REDIRECT_URI must match the callback registered in the Yahoo app.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=

# Shared secret protecting POST /api/rankings/sync. In production the route
# fails closed when this is unset; locally it stays open for convenience.
RANKINGS_SYNC_SECRET=

# AI announcer (cloud voice generation). Off everywhere unless the flag is
# exactly "true"; OPENAI_API_KEY is what actually generates the audio.
NEXT_PUBLIC_AI_ANNOUNCER_ENABLED=false
OPENAI_API_KEY=
