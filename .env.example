NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side tooling only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-secret-key

# Transactional email sender. Must be on a domain verified in Resend.
# Leave unset locally to use Resend's shared sandbox sender.
RESEND_FROM="DraftHQ <noreply@drafthq.net>"
