NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Origin used to build auth redirect and invite links.
# Local: http://localhost:3000   Production: https://drafthq.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side tooling only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-secret-key

# Transactional email (Resend).
RESEND_API_KEY=your-resend-api-key
# Defaults to the shared "DraftHQ <onboarding@resend.dev>" sender.
# Switch to DraftHQ <noreply@drafthq.net> once drafthq.net is verified in Resend.
RESEND_FROM=DraftHQ <onboarding@resend.dev>
